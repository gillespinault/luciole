# Tout ce que tools/build.sh régénère
*/out/

# Fiches techniques et photos des fabricants : gardées en local, pas publiées.
# Leur liste et leurs sources sont dans fiches/README.md, qui est suivi.
fiches/*
!fiches/README.md

# Fichiers locaux de KiCad
*.kicad_prl
*-backups/
fp-info-cache
~*.lck
*.lck

__pycache__/

# Outils tiers (routeurs automatiques), installés à version figée : voir README.md
tiers/

# Modèles SPICE téléchargés chez les fabricants : gardés en local, pas publiés, comme les
# fiches. Leurs adresses sont dans le README de chaque dossier de simulation.
v0/simu/modeles/AO3400.mod
v0/simu/modeles/AO3401A.mod
v0/simu/modeles/DMP1045U.spice.txt
v0/simu-signaux/modeles/bss138_onsemi.lib
v0/simu-signaux/modeles/bss138_onsemi_thermique.lib
# Journaux bruts de ngspice
v0/simu/resultats/journaux/
v0/simu-signaux/sorties/

# Coûts, devis et hypothèses commerciales : gardés en local, pas publiés. Le dépôt ne porte
# que ce qui a un intérêt pour la communauté.
tools/couts.py
v0/couts/
