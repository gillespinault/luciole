/*
 * Luciole² — réglages. Tout est en microsecondes (esp_timer) sauf mention contraire.
 *
 * Trois couches de rendu, pilotées par des règles locales sans coordinateur :
 *  - tempérament : agitation haute (seule) = étincelles ; basse (groupe) = respiration synchronisée + pouls
 *  - lien        : les bouts du ruban se tendent vers la voisine la plus proche (RSSI lissé)
 *  - onde        : bouton → bande qui traverse le ruban puis saute à la voisine la plus proche non traversée
 */
#pragma once
#include <stdint.h>

/* Grille rythmique */
#define L2_BEATS_PER_BAR    5
#define L2_BEAT_MS          500
#define L2_BEAT_US          ((int64_t)L2_BEAT_MS * 1000)
#define L2_BAR_US           (L2_BEAT_US * L2_BEATS_PER_BAR)

/* Flash d'un temps */
#define L2_FLASH_US         70000
#define L2_DECAY_US         250000
#define L2_MAX_BRIGHTNESS   255     /* LED intégrée */

/* Radio */
#define L2_WIFI_CHANNEL     1
#define L2_LONG_RANGE       1       /* mode longue portée Espressif (250 kbit/s, ~+10 dB) : toutes les unités doivent l'avoir */
#define L2_TX_POWER         80      /* quarts de dBm : 80 = 20 dBm, le maximum */
#define L2_SEND_JITTER_MS   60
#define L2_BEACON_TARGET_RATE 20.0f /* balises/s entendues au-delà desquelles on ralentit les siennes */
#define L2_BEACON_MAX_MS    5000

/* Synchronisation de phase */
#define L2_PHASE_GAIN       0.3f
#define L2_LINK_LATENCY_US  3000
#define L2_PHASE_DEADBAND_US 5000

/* Voisines */
#define L2_MAX_NEIGHBORS    16
#define L2_NEIGHBOR_TTL_US  6000000 /* oubliée après 6 s sans balise (balises ralenties en foule) */
/* En longue portée le récepteur descend vers -105 dBm : toute luciole entendue
 * compte comme voisine, le RSSI ne sert qu'à graduer la proximité (lien).
 * Mesures du 12 octobre : quelques cm sur le hub -36…-69 dBm, 7,5 m en
 * intérieur -93…-97 dBm. */
#define L2_RSSI_ENTER       -100
#define L2_RSSI_LEAVE       -106
#define L2_RSSI_ALPHA       0.3f
#define L2_RSSI_NEAR        -55     /* dBm : lien plein (collées) */
#define L2_RSSI_FAR         -100    /* dBm : lien nul (limite d'écoute) */
#define L2_REACH_ALPHA      0.05f   /* lissage du lien, par trame de rendu (100 Hz) */

/* Tempérament : agitation 0 (calme, groupe) .. 1 (seule, foufou) */
#define L2_AGIT_TARGET_GAIN 0.15f   /* par cycle, vers la cible donnée par densité et lien */
#define L2_AGIT_SOCIAL_GAIN 0.25f   /* par cycle, vers la moyenne des voisines (corégulation) */
#define L2_AGIT_PULSE_THRESHOLD 0.5f /* le pouls n'apparaît qu'en dessous */
#define L2_AGIT_WAVE_BUMP   0.3f    /* une onde qui passe excite */
#define L2_SPARKLE_RATE     8.0f    /* étincelles/s à agitation 1 */
#define L2_SPARKLE_US       180000
#define L2_MAX_SPARKLES     8
#define L2_HUE_WANDER_DEG   40.0f   /* vagabondage de teinte par cycle, à agitation 1 */

/* Couleur par consensus, degrés */
#define L2_HUE_GAIN         0.25f
#define L2_HUE_HOME_GAIN    0.05f
#define L2_HUE_WAVE_GAIN    1.0f    /* trace laissée par une onde : on adopte la couleur de l'origine */
/* Spectre : le ruban montre un morceau d'arc-en-ciel centré sur la teinte du
 * groupe. Seule (agitation 1), tout le cercle des teintes défile ; corégulée
 * (agitation 0), le morceau se resserre à une seule couleur. */
#define L2_SPECTRUM_MIN_DEG 12.0f   /* largeur résiduelle une fois le groupe accordé */
#define L2_SPECTRUM_FLOW    0.25f   /* tours/s de défilement à agitation 1 */

/* Onde */
#define L2_BUTTON_ENABLED   1
#define L2_WAVE_SWEEP_US    500000  /* traversée du ruban = un saut */
#define L2_WAVE_TRAIL_US    3000000 /* traînée après le passage */
#define L2_WAVE_FANOUT      1       /* destinataires par saut : 1 = serpent, 2 = vague */
#define L2_WAVE_RELAY_WAIT_US 700000 /* attente du relais de la destinataire avant d'essayer la suivante */
#define L2_WAVE_RELAY_TRIES 3
#define L2_WAVE_RECORDS     8       /* ondes récentes en mémoire */
#define L2_WAVE_PLAYERS     16      /* unités connues pour avoir joué une onde donnée */
#define L2_WAVE_MIN_PLAY_US 2000000 /* au plus une onde jouée toutes les 2 s */
#define L2_WAVE_MIN_EMIT_US 10000000 /* au plus une onde émise toutes les 10 s */
#define L2_BUTTON_DEBOUNCE_MS 30

/* Rendu */
#define L2_RENDER_MS        10
#define L2_GAMMA            2.2f    /* fondus perçus comme linéaires */

/* Brochage M5NanoC6 */
#define L2_RGB_DATA_GPIO    20
#define L2_RGB_POWER_GPIO   19
#define L2_BUTTON_GPIO      9
#define L2_BLUE_LED_GPIO    7
#define L2_TICK_US          15000

/* Ruban SK6812 sur le Grove : donnée fil jaune = G2. 5 V = VBUS direct, 600 mA max. */
#define L2_STRIP_ENABLED        1
#define L2_STRIP_TEST           0
#define L2_STRIP_GPIO           2
#define L2_STRIP_LEDS           10
#define L2_STRIP_MAX_BRIGHTNESS 120     /* ~47 % : 10 LED blanc ≈ 280 mA de pic */

/* Trames ESP-NOW : en-tête commun, puis le corps selon le type. */
#define L2_PROTO_VERSION 3
#define L2_MSG_BEACON    0
#define L2_MSG_WAVE      2

typedef struct __attribute__((packed)) {
    uint8_t  magic[2];      /* 'L' '2' */
    uint8_t  version;
    uint8_t  type;
} l2_hdr_t;

typedef struct __attribute__((packed)) {
    l2_hdr_t hdr;
    uint8_t  level;         /* niveau de densité de l'émettrice */
    uint8_t  hue;           /* teinte, 0-255 pour 0-360° */
    uint8_t  agit;          /* agitation, 0-255 */
    uint8_t  reserved;
    uint32_t phase_us;      /* position dans le cycle à l'envoi */
    uint32_t seq;
} l2_beacon_t;

/* Onde : « j'ai joué l'onde (origin, id), à toi target ». target = ff:ff:… = « joué, personne ensuite ». */
typedef struct __attribute__((packed)) {
    l2_hdr_t hdr;
    uint8_t  origin[6];
    uint16_t id;
    uint8_t  target[6];
    uint8_t  hop;
    uint8_t  hue;
} l2_wave_t;
