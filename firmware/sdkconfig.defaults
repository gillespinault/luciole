# Luciole² — réglages communs à toutes les cartes. Le spécifique est dans sdkconfig.defaults.<cible>.

# Console sur l'USB-Serial/JTAG natif (NanoC6, AtomS3 Lite : pas de pont UART).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Pas de Wi-Fi station ni d'identifiants à stocker ; la NVS ne sert qu'à notre configuration.
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Tick FreeRTOS à 1 kHz : la boucle de rendu tourne toutes les 10 ms.
CONFIG_FREERTOS_HZ=1000

# Table de partitions : application de 3 Mo, NVS à 0x9000 (le flashage web y écrit la configuration).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
